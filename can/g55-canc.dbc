CM_ "Only signals confirmed from a single 2011 W463 test vehicle are included. VIN payloads are intentionally omitted.";
CM_ SG_ 281 PayloadCRC8 "Measured: CRC-8/SAE J1850 over bytes 0-6: poly 0x1D, init 0xFF, xorout 0xFF, non-reflected.";
CM_ SG_ 329 PayloadCRC8 "Measured: CRC-8/SAE J1850 over bytes 0-6: poly 0x1D, init 0xFF, xorout 0xFF, non-reflected.";
CM_ SG_ 337 PayloadCRC8 "Measured: CRC-8/SAE J1850 over bytes 0-6: poly 0x1D, init 0xFF, xorout 0xFF, non-reflected.";
CM_ SG_ 342 PayloadCRC8 "Measured: CRC-8/SAE J1850 over bytes 0-6: poly 0x1D, init 0xFF, xorout 0xFF, non-reflected.";
CM_ SG_ 566 PayloadCRC8 "Measured: CRC-8/SAE J1850 over bytes 0-6: poly 0x1D, init 0xFF, xorout 0xFF, non-reflected.";
CM_ SG_ 566 SteeringAngleRaw "Measured: Matches the 0x238 sign/magnitude copy; positive is right. Provisional: physical degrees/count (~0.0439 deg/count).";
CM_ SG_ 566 SteeringAngularVelocityRaw "Measured: Tracks the smoothed derivative of SteeringAngleRaw. Provisional: physical scale.";
CM_ SG_ 568 SteeringAngleNegative "Measured: Apply sign to SteeringAngleMagnitudeRaw (1 means negative).";
CM_ SG_ 568 TurnSignalLeft "Measured: Held stalk request; equals CAN-B 0x006 MRM_A1 BLI_LI.";
CM_ SG_ 568 TurnSignalRight "Measured: Held stalk request; equals CAN-B 0x006 MRM_A1 BLI_RE.";
CM_ SG_ 560 SelectorLeverPosition "Measured: EWM_230h WHC low nibble (P/R/N/D). Real DLC is 1.";
CM_ SG_ 576 LowBeamOn "Measured: EZS_240h ABL_EIN; equals CAN-B 0x00A SAM_V low-beam status.";
CM_ SG_ 824 TransmissionOutputSpeedRaw "Measured: Full 16-bit big-endian word; 0xFFFF means unavailable. Provisional: physical rpm scale.";
CM_ SG_ 824 TransmissionTurbineSpeed "Measured: Full 16-bit big-endian word at 1 rpm/count; 0xFFFF means unavailable.";
CM_ BO_ 512 "Measured: Wheel speeds are 14-bit fields; the top two bits of each word are separate direction enums.";
CM_ BO_ 520 "Measured: Wheel speeds are 14-bit fields; the top two bits of each word are separate direction enums.";
CM_ SG_ 768 YawRateRaw "Measured: Centered at raw word 0x8000; 0x4000 and 0xFFFF are invalid/state sentinels; positive is left. Provisional: physical scale.";
CM_ SG_ 768 DriverBraking "Measured: BS_300h SFB; equals 0x200 BrakeLightSwitch in 99.998% of samples.";
CM_ SG_ 768 DriverBrakingParity "Measured: Even parity over DriverBraking and this bit.";
CM_ SG_ 512 BrakeLightSwitch "Measured: BS_200h BLS.";
CM_ SG_ 776 EngineOilTemperature "Measured: Raw byte 5 minus 40 degC (0xFF sentinel).";
CM_ SG_ 786 EngineTorqueStatic "Derived/Borrowed: 13-bit signed-offset modeled engine torque (raw * 0.25 - 500 Nm; 0x1FFF sentinel).";
CM_ SG_ 808 LateralAccelerationRaw "Measured: Centered at raw byte 0x80; 0x00 and 0xFF are sentinels; positive is left. Provisional: 0.08 m/s^2 per count.";
CM_ SG_ 816 LongitudinalAccelerationRaw "Measured: Centered near raw byte 0x80; 0x00 and 0xFF are sentinels. Provisional: 0.08 m/s^2 per count.";
CM_ SG_ 528 AcceleratorPedalRaw "Measured: Zero at released pedal and rises to ~250 at full pedal travel.";
CM_ SG_ 1048 GearboxOilTemperature "Measured: Valid only when ActualGear (byte 4 low nibble) is 1..5; raw byte 2 minus 50 degC.";
CM_ SG_ 1064 TransferCaseState "Measured: VG_428h low 3 bits (1=LOW, 2=HIGH).";
CM_ SG_ 1544 EngineCoolantTemperature "Measured: Exact gateway copy of CAN-B 0x002 byte 4; raw byte 0 minus 40 degC.";
CM_ SG_ 1544 EngineIntakeAirTemperature "Measured: Raw byte 1 minus 40 degC (0xFF sentinel).";

